# Snyk (https://snyk.io) policy file
# This file configures which vulnerabilities to ignore and sets thresholds

{
  "version": "v1.22.1",
  "ignore": {
    # Ignore specific CVEs with justification and expiry
    # Format: "CVE-ID": [
    #   {
    #     "*": {
    #       "reason": "Justification for ignoring",
    #       "expires": "YYYY-MM-DD"
    #     }
    #   }
    # ]
  },
  "patch": [],
  "thresholds": {
    "high": 0,
    "medium": 5,
    "low": 20
  },
  "exclude": {
    "directories": [
      "node_modules/",
      "venv/",
      ".venv/",
      "__pycache__/",
      ".git/",
      "contracts/artifacts/",
      "contracts/cache/"
    ],
    "files": [
      "package-lock.json",
      "yarn.lock"
    ]
  },
  "monitor": {
    "devDependencies": false,
    "allSubProjects": true,
    "projectName": "nft-gated-adult-fan-club-compliance",
    "targetReference": "main"
  },
  "supportedProjects": [
    "requirements.txt",
    "package.json",
    "hardhat.config.ts"
  ]
}
