apiVersion: v1
kind: Secret
metadata:
  name: nft-fanclub-secrets
  namespace: nft-fanclub
  labels:
    app.kubernetes.io/name: nft-fanclub
    app.kubernetes.io/part-of: nft-platform
type: Opaque
stringData:
  # Database
  DATABASE_URL: "postgresql+asyncpg://postgres:CHANGE_ME@nft-fanclub-postgres:5432/nft_fanclub"
  DATABASE_URL_SYNC: "postgresql://postgres:CHANGE_ME@nft-fanclub-postgres:5432/nft_fanclub"

  # Redis
  REDIS_URL: "redis://:CHANGE_ME@nft-fanclub-redis:6379/0"

  # Authentication
  JWT_SECRET: "CHANGE_ME_JWT_SECRET_64_CHARS_MINIMUM"
  JWT_PUBLIC_KEY: ""
  ENCRYPTION_KEY: "CHANGE_ME_ENCRYPTION_KEY_32_BYTES"

  # Blockchain
  WALLET_PRIVATE_KEY: "CHANGE_ME_WALLET_PRIVATE_KEY"

  # Payments
  STRIPE_SECRET_KEY: "sk_live_CHANGE_ME"
  STRIPE_WEBHOOK_SECRET: "whsec_CHANGE_ME"
  STRIPE_PUBLISHABLE_KEY: "pk_live_CHANGE_ME"

  # External APIs
  INFURA_PROJECT_ID: "CHANGE_ME"
  ALCHEMY_API_KEY: "CHANGE_ME"
  KYC_PROVIDER_API_KEY: "CHANGE_ME"
  KYC_PROVIDER_API_SECRET: "CHANGE_ME"
  AML_PROVIDER_API_KEY: "CHANGE_ME"

  # SMTP / Email
  SMTP_HOST: "CHANGE_ME"
  SMTP_PORT: "587"
  SMTP_USER: "CHANGE_ME"
  SMTP_PASSWORD: "CHANGE_ME"
  EMAIL_FROM: "noreply@nft-fanclub.example.com"

  # Sentry
  SENTRY_DSN: "CHANGE_ME"

  # Admin
  ADMIN_API_KEY: "CHANGE_ME"
  ADMIN_EMAIL: "admin@nft-fanclub.example.com"
  ADMIN_PASSWORD_HASH: "CHANGE_ME_BCRYPT_HASH"
